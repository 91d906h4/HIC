/*
    HyLang standard math module.

    Imported with:  #import <math.hm>
*/

// Absolute value of an integer.
function abs(int n){
    if(n < 0){
        return -n;
    }
    return n;
}

// Integer power: base raised to exp.
function pow(int base, int exp){
    int result = 1;
    for(int i = 0; i < exp; i = i + 1){
        result = result * base;
    }
    return result;
}

// Largest of two integers.
function max(int a, int b){
    if(a > b){
        return a;
    }
    return b;
}
