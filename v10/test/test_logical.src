// Test logical operators
var a = true;
var b = false;

// Test AND
print(a && a);  // Should print 1
print(a && b);  // Should print 0
print(b && a);  // Should print 0
print(b && b);  // Should print 0

// Test OR
print(a || a);  // Should print 1
print(a || b);  // Should print 1
print(b || a);  // Should print 1
print(b || b);  // Should print 0

// Test NOT
print(!a);      // Should print 0
print(!b);      // Should print 1
print(!!a);     // Should print 1

// Test combinations
print(a && b || a);  // Should print 1
print(!a || b);      // Should print 0

// Test with numbers (truthiness)
var zero = 0;
var one = 1;
print(!zero);   // Should print 1
print(!one);    // Should print 0
print(zero || one);  // Should print 1
