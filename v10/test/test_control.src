// Test break statement
print("Testing break:");
var i = 0;
while (i < 10) {
    if (i == 5) {
        break;
    }
    print(i);
    i = i + 1;
}
print("After break");

// Test continue statement
print("Testing continue:");
var j = 0;
while (j < 5) {
    j = j + 1;
    if (j == 3) {
        continue;
    }
    print(j);
}
print("After continue");

// Test break in for loop
print("Testing break in for:");
for (var k = 0; k < 10; k = k + 1) {
    if (k == 3) {
        break;
    }
    print(k);
}

// Test continue in for loop
print("Testing continue in for:");
for (var m = 0; m < 5; m = m + 1) {
    if (m == 2) {
        continue;
    }
    print(m);
}
