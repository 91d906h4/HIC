// ============================================
// 15. PYTORCH TRAINING
// ============================================
print("15. PyTorch:");
import torch;

var t_randn = torch.randn;
var nn = torch.nn;
var optim = torch.optim;

var NUMBER_OF_DATA  = 64;
var INPUT_FEATURES  = 1000;
var HIDDEN_FEATURES = 100;
var OUTPUT_FEATURES = 10;
var x = t_randn(NUMBER_OF_DATA, INPUT_FEATURES);
var y = t_randn(NUMBER_OF_DATA, OUTPUT_FEATURES);

var model = nn.Sequential(
            nn.Linear(INPUT_FEATURES, HIDDEN_FEATURES),
            nn.ReLU(),
            nn.Linear(HIDDEN_FEATURES, OUTPUT_FEATURES));
var LEARNING_RATE = 0.03;
var EPOCHS = 100;

var criterion = nn.MSELoss();
var optimizer = optim.SGD(
    model.parameters(),
    lr=LEARNING_RATE);

function train_step(train_X, train_y) {
    model.train();

    var pred_y = model(train_X);

    optimizer.zero_grad();
    var loss = criterion(pred_y, train_y);

    loss.backward();
    optimizer.step();

    return loss.item();
}

for (var i = 0; i < EPOCHS; i++) {
    var loss_result = train_step(x, y);
    print(str(i) + ": " + str(loss_result));
}
print("Finished Training");

// ============================================
// 16. CLASS
// ============================================
print("16. Class:");

class Counter {
    function constructor(start) {
        this.count = start;
    }
    
    function increment() {
        this.count = this.count + 1;
    }

    function decrement() {
        this.count = this.count - 1;
    }
    
    function get() {
        return this.count;
    }
}

var c = Counter(10);
c.increment();
c.increment();
print("Count: " + str(c.get()));


// ============================================
// 17. DONE
// ============================================
print("Done");
