// ============================================
// 10. EXCEPTION HANDLING
// ============================================
print("10. Exception Handling:");
try {
    var content = readfile("nonexistent.txt");
    print("  File content: " + content);
} catch {
    print("  Caught error: File not found!");
}

try {
    var result = 10;
    if (result > 5) {
        throw "Value too large!";
    }
} catch {
    print("  Caught custom error!");
}
print("");

