// ============================================
// HIC Language - Complete Feature Demo
// ============================================

print("=== HIC Language Feature Showcase ===");
print("");

// ============================================
// 1. TYPELESS VARIABLES
// ============================================
print("1. Typeless Variables:");
var name = "Alice";
var age = 25;
var score = 95.5;
var isActive = true;
var data = none;
print("  name = " + name);
print("  age = " + str(age));
print("  score = " + str(score));
print("  isActive = " + str(isActive));
print("  data = " + str(data));
print("");

// ============================================
// 2. BOOLEAN LITERALS & LOGICAL OPERATORS
// ============================================
print("2. Boolean Literals & Logical Operators:");
var a = true;
var b = false;
print("  a = " + str(a) + ", b = " + str(b));
if (a && b) {
    print("  a && b = true");
} else {
    print("  a && b = false");
}
if (a || b) {
    print("  a || b = true");
} else {
    print("  a || b = false");
}
print("  !a = " + str(!a));
print("");

// ============================================
// 3. CONTROL FLOW
// ============================================
print("3. Control Flow (if/else):");
if (age >= 18 && isActive) {
    print("  Status: Adult and Active");
} else if (age >= 18) {
    print("  Status: Adult but Inactive");
} else {
    print("  Status: Minor");
}
print("");

// ============================================
// 4. ARRAYS & BUILT-IN FUNCTIONS
// ============================================
print("4. Arrays & Built-in Functions:");
var numbers[0];
push(numbers, 10);
push(numbers, 20);
push(numbers, 30);
push(numbers, 40);
push(numbers, 50);
print("  Array: " + str(numbers));
print("  Length: " + str(len(numbers)));
print("  First element: " + str(numbers[0]));
print("  Last element: " + str(numbers[4]));
var popped = pop(numbers);
print("  Popped: " + str(popped));
print("  New length: " + str(len(numbers)));
print("");

// ============================================
// 5. LOOPS WITH BREAK & CONTINUE
// ============================================
print("5. Loops with break & continue:");
print("  While loop (skip 20, break at 40):");
var i = 0;
while (i < len(numbers)) {
    var val = numbers[i];
    i += 1;
    
    if (val == 20) {
        continue;  // Skip 20
    }
    if (val == 40) {
        break;     // Stop at 40
    }
    print("    " + str(val));
}

print("  For loop (print 1-5):");
for (var j = 1; j <= 5; j++) {
    print("    " + str(j));
}
print("");

// ============================================
// 6. DICTIONARIES
// ============================================
print("6. Dictionaries:");
var person = {"name": "Bob", "age": 30, "city": "NYC"};
print("  person['name'] = " + person["name"]);
print("  person['age'] = " + str(person["age"]));
print("  person['city'] = " + person["city"]);
person["age"] = 31;
print("  Updated age: " + str(person["age"]));
print("");

// ============================================
// 7. FUNCTIONS
// ============================================
print("7. Functions:");

function fibonacci(var n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

function factorial(var n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

function pass_by_name(var a, var b) {
    print("a = " + str(a));
    print("b = " + str(b));
}

print("  fibonacci(10) = " + str(fibonacci(10)));
print("  factorial(5) = " + str(factorial(5)));
pass_by_name(b=2, a=1);
print("");

// ============================================
